{
  "name": "identity-management-frontend",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "sideEffects": [
    "./src/index.tsx",
    "./src/i18n.ts",
    "./src/components-care/patches/ImageTypeDeserializer.ts"
  ],
  "scripts": {
    "build": "webpack-cli",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint-fix": "eslint --fix 'src/**/*.{ts,tsx}'",
    "prepare": "husky",
    "start": "webpack-dev-server --mode development --server-type https"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --max-warnings=0 --fix",
    "*.json": "prettier --write"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-date-pickers": "^9.13.0",
    "@sentry/react": "^10.73.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "components-care": "github:Samedis-care/react-components#master_dist",
    "dompurify": "^3.4.16",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-chained-backend": "^5.0.6",
    "i18next-http-backend": "^4.0.2",
    "i18next-localstorage-backend": "^4.3.2",
    "js-cookie": "^3.0.8",
    "js-md5": "^0.9.2",
    "marked": "^18.0.11",
    "mdi-material-ui": "^8.0.0",
    "moment": "^2.31.0",
    "react": "^19.2.8",
    "react-color": "^2.19.3",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-password-strength-bar": "^0.4.1",
    "react-recaptcha": "^2.3.10",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-recaptcha": "^2.3.7",
    "@typescript-eslint/parser": "^8.69.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "html-webpack-plugin": "^5.6.8",
    "http-proxy-middleware": "^4.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": "^11"
  },
